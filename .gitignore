# --- Project data and generated artifacts -----------------------------------
# Downloaded datasets, caches, manifests and model outputs are reproducible;
# they must not be committed. Keep the directory shape with .gitkeep files.
data/*
!data/.gitkeep
artifacts/*
!artifacts/.gitkeep
reports/*
!reports/.gitkeep

